# Nav obligāts. Nokopējiet uz .env, ja vēlaties savas vērtības. .env nekad netiek iesniegts repozitorijā.
# Ja nav norādīts, konteiners ģenerē nejaušu atslēgu un glabā to sējumā.
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
SEED_DEMO=1
# Telefonam lokālajā tīklā: http://<datora-IP>:8000
API_BASE_URL=http://localhost:8000
